{
  "name": "gospelmigration",
  "main": "worker.ts",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["33 2 * * *", "0 4 * * *", "23 6 * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "gospelchannel.com/*",
      "zone_name": "gospelchannel.com"
    },
    {
      "pattern": "www.gospelchannel.com/*",
      "zone_name": "gospelchannel.com"
    }
  ],
  // Self-reference so the ISR queue can ask this worker to rebuild a page.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gospelmigration"
    }
  ],
  // OpenNext cache: background rebuild queue and the tag cache behind
  // revalidateTag/revalidatePath (see open-next.config.ts).
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHURCH_ASSETS",
      "bucket_name": "church-assets",
      "preview_bucket_name": "church-assets-preview"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gospelchannel-next-cache",
      "preview_bucket_name": "gospelchannel-next-cache-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "GOSPEL_D1",
      "database_name": "gospelchannel",
      "database_id": "4e2cba8a-5e0b-4c7b-aea3-6c6440b39d09",
      "migrations_dir": "drizzle-d1"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://gospelchannel.com",
    "NEXT_PUBLIC_MEDIA_BASE_URL": "https://media.gospelchannel.com"
  }
}
