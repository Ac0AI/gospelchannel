# Pin the Node.js runtime for this project so every pnpm command (install,
# run deploy, cf:build, exec) uses Node 22 automatically, regardless of the
# machine's default Node. pnpm downloads and manages this version itself.
# This is what makes `pnpm run deploy` work without ERR_PNPM_UNSUPPORTED_ENGINE
# (package.json engines pins node to 22.x) and without any manual PATH/nvm.
use-node-version=22.23.1
